#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int s, d;
    char ch;

    s = open("source.txt", O_RDONLY);
    d = open("dest.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    while (read(s, &ch, 1))
        write(d, &ch, 1);

    close(s);
    close(d);

    printf("File copied successfully\n");
    return 0;
}
